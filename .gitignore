# BeQuite — repository .gitignore
# Receipts, memory, and prompts ARE tracked. Secrets, build outputs, and per-developer state are not.

# --- Secrets (Article V — never committed) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
.bequite/.keys/
.bequite/.auth/

# --- Python ---
# Note: virtualenv install dirs anchored to root with leading slash so they
# don't silently swallow application source dirs named `lib/` (e.g.
# studio/api/src/lib/, studio/dashboard/lib/). Same applies to build/dist.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.yarn/
.next/
.turbo/
.parcel-cache/
.cache/
*.tsbuildinfo

# --- Rust / Tauri ---
target/
Cargo.lock.bak
src-tauri/target/

# --- IDE / OS ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Coverage & test outputs ---
coverage/
.nyc_output/
playwright-report/
test-results/
e2e-results/

# --- BeQuite per-developer state ---
.bequite/auto-state/*.json
.bequite/replays/
.bequite/cache/

# --- BeQuite tracked artifacts (DO NOT IGNORE) ---
# Receipts, memory, prompts, logs, decisions, specs, AGENTS.md, CLAUDE.md, doctrines
# are all tracked. Listed here for clarity:
# !.bequite/memory/
# !.bequite/receipts/
# !.bequite/memory/prompts/

# --- Local-only configs (override-able) ---
.claude/settings.local.json
*.local.toml

# --- Generated docs ---
docs/_build/
site/
# Playwright artifacts
tests/e2e/node_modules/
tests/e2e/test-results/
docs/audits/screenshots/_playwright-output/
docs/audits/screenshots/_playwright-report/

# Root-level npm/Node
node_modules/


# Motion reference library: third-party films and frames stay local (copyright + repo size).
# Only the written breakdowns (*.md) are tracked.
motion-library/inbox/*
!motion-library/inbox/.gitkeep
motion-library/refs/*/frames/
motion-library/**/*.mp4
motion-library/**/*.mov
motion-library/**/*.webm
motion-library/**/*.mkv
motion-library/**/*.gif
motion-library/**/*.png
motion-library/**/*.jpg
motion-library/**/*.jpeg
motion-library/**/*.webp
motion-library/**/*.wav
motion-library/**/*.mp3
motion-library/**/*.pdf

# The repo's own BeQuite working memory stays local (the shipped scaffold lives in templates/bequite/).
.bequite/
